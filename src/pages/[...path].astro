---
import type { GetStaticPaths } from 'astro';
import ArticleList from '../components/ArticleList.astro';
import ArticlePage from '../components/ArticlePage.astro';
import Interests from '../components/Interests.astro';
import ProfileHome from '../components/ProfileHome.astro';
import SiteLayout from '../components/SiteLayout.astro';
import { getSiteRoutes, type Route } from '../lib/routes';
import { content, githubUrl, infinitePath, pagePath } from '../lib/site';
import { articleData, profileData } from '../lib/structured-data';

export const getStaticPaths = (async () => {
  const routes = await getSiteRoutes();
  return routes.map(route => ({
    params: { path: route.path.slice(1, -1) || undefined },
    props: {
      route,
      showResearch: routes.some(other => other.path === pagePath('research', route.language)),
    },
  }));
}) satisfies GetStaticPaths;

interface Props { route: Route; showResearch: boolean }
const { route, showResearch } = Astro.props;
const { language, alternates, path } = route;
const copy = content[language];
const [title, description] = route.kind === 'article'
  ? [route.article.data.title, route.article.data.description]
  : copy.pages[route.page];
const isProfile = route.kind === 'page' && (route.page === 'home' || route.page === 'about');
const schema = route.kind === 'article' ? articleData(path, route.article) : isProfile
  ? profileData(path, language, description) : undefined;
---

<SiteLayout {language} {path} {title} {description} {alternates} {showResearch}
  structuredData={schema}
  kind={route.kind === 'article' ? 'article' : isProfile ? 'profile' : 'website'}
  active={route.kind === 'article' ? route.article.data.section : route.page}>
  {route.kind === 'article' ? <ArticlePage article={route.article} /> : (
    route.page === 'home' ? <ProfileHome {language} articles={route.articles} /> : (
      <div class="content-frame inner-page">
        <h1>{title}</h1>
        {route.page === 'about' && (
          <div class="about-grid">
            <div class="prose">
              <p>{copy.aboutWork}</p>
              <p>{copy.aboutStudy}</p>
              <p>{copy.aboutInterests}</p>
            </div>
            <Interests {language} />
          </div>
        )}
        {route.page === 'projects' && (
          <section class="project-panel project-detail" id="infinite" aria-labelledby="infinite-title">
            <div>
              <h2 id="infinite-title">Infinite</h2>
              <p>{copy.infinite}</p>
            </div>
            <a class="project-link" href={infinitePath(language)}>
              {copy.viewProject} <span aria-hidden="true">→</span>
            </a>
          </section>
        )}
        {(route.page === 'writing' || route.page === 'research') && (
          route.articles.length ? <ArticleList articles={route.articles} {language} />
            : <p class="page-lead">{copy.writingEmpty}</p>
        )}
        {route.page === 'contact' && (
          <>
            <p class="page-lead">{copy.contact}</p>
            <p><a class="mono" href={githubUrl}>{copy.githubLabel} · axelrdz-4766</a></p>
          </>
        )}
      </div>
    )
  )}
</SiteLayout>
